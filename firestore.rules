rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'createdAt']) &&
               data.email is string && data.email.size() <= 256 &&
               data.createdAt == request.time &&
               (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
               (data.get('barangay', '') is string && data.get('barangay', '').size() <= 100);
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().email == request.auth.token.email;
      allow update: if isOwner(userId) && 
                      (incoming().get('email', existing().email) == existing().email) &&
                      (incoming().get('createdAt', existing().createdAt) == existing().createdAt) &&
                      incoming().updatedAt == request.time &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'email', 'createdAt', 'barangay']);
    }

    // Report Rules
    match /reports/{reportId} {
      function isValidReport(data) {
        return data.keys().hasAll(['userId', 'barangay', 'issueType', 'status', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.barangay is string && data.barangay.size() <= 100 &&
               data.issueType is string && data.issueType.size() <= 100 &&
               data.status in ['pending', 'in-progress', 'resolved'] &&
               data.createdAt == request.time &&
               data.get('description', '') is string && data.get('description', '').size() <= 1000;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidReport(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['description', 'location', 'updatedAt', 'status']);
    }
  }
}
